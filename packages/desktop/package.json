{
  "name": "@tidy/desktop",
  "productName": "git tidy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "start": "electron .",
    "smoke": "electron . --smoke"
  },
  "dependencies": {
    "@tidy/core": "workspace:*",
    "@tidy/server": "workspace:*"
  },
  "devDependencies": {
    "electron": "^44.4.5"
  }
}
